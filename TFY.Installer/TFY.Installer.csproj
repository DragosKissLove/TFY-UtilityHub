<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TFY.Installer</AssemblyName>
    <RootNamespace>TFY.Installer</RootNamespace>
    <Title>TFY Utility Hub Installer</Title>
    <Product>TFY Utility Hub Installer</Product>
    <Company>TFY</Company>
    <Version>6.3.2</Version>
    <Authors>TFY</Authors>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyVersion>6.3.2.0</AssemblyVersion>
    <FileVersion>6.3.2.0</FileVersion>
    <ApplicationIcon>..\installer\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="publish.zip" />
    <EmbeddedResource Include="dist.zip" />
  </ItemGroup>
</Project>
