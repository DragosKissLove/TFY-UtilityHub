{
    "hosting": {
        "public": "project/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "Releases/**/*.exe",
            "optimizations/**"
        ],
        "rewrites": [
            {
                "source": "!/Releases/**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/Releases/**/RELEASES",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "**/*.@(js|css)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            },
            {
                "source": "/index.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=0, must-revalidate"
                    }
                ]
            }
        ]
    }
}